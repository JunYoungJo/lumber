{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumber",
  "version": "0.1.3",
  "identifier": "com.jyjo.lumber",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lumber",
        "width": 1320,
        "height": 860,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5MUYwNUU0N0UyNDZFQ0UKUldUT2JpUis1QVVmeWZuVG9sUkhlWkRTemZuN2RTRENVb1dMTVIveHhOaCtiSXdlYmJtbENhd2gK",
      "endpoints": [
        "https://github.com/JunYoungJo/lumber/releases/latest/download/latest.json"
      ]
    }
  }
}
